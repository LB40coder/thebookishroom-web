d:[["$","title","0",{"children":"Books | The Bookish Room"}],["$","meta","1",{"name":"description","content":"Explore individual book pages with editorial details, reading difficulty, moods, and similar book recommendations."}],["$","meta","2",{"name":"google-adsense-account","content":"ca-pub-3071913387535313"}],["$","meta","3",{"property":"og:title","content":"Books | The Bookish Room"}],["$","meta","4",{"property":"og:description","content":"Explore individual book pages with editorial details, reading difficulty, moods, and similar book recommendations."}],["$","meta","5",{"property":"og:site_name","content":"The Bookish Room"}],["$","meta","6",{"property":"og:locale","content":"en_US"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"Books | The Bookish Room"}],["$","meta","10",{"name":"twitter:description","content":"Explore individual book pages with editorial details, reading difficulty, moods, and similar book recommendations."}],["$","link","11",{"rel":"icon","href":"/images/favicon.png"}],["$","link","12",{"rel":"apple-touch-icon","href":"/images/favicon.png"}],["$","$L10","13",{}]]
