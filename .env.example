# Database (Vercel Neon integration sets POSTGRES_PRISMA_URL automatically)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# ── API (apps/api) — Vercel ──────────────────────────────────────────────────
ADMIN_PATH=""
ADMIN_API_KEY=""
SESSION_SECRET=""
ADMIN_PASSWORD_HASH=""

# Vercel Blob for Studio image uploads
# BLOB_READ_WRITE_TOKEN=""

# Allowed CORS origin for public API (production)
NEXT_PUBLIC_SITE_URL="https://www.thebookishroom.com"

# ── Web (apps/web) — Cloudflare Pages ────────────────────────────────────────
# Public site URL (Open Graph, share links)
NEXT_PUBLIC_SITE_URL="https://www.thebookishroom.com"

# Backend API URL (server-side fetch during SSR/build)
API_URL="https://api.thebookishroom.com"

# Backend API URL (client-side: search, book-finder)
NEXT_PUBLIC_API_URL="https://api.thebookishroom.com"

# ── Local development ────────────────────────────────────────────────────────
# API_URL="http://localhost:3457"
# NEXT_PUBLIC_API_URL="http://localhost:3457"
# NEXT_PUBLIC_SITE_URL="http://localhost:3456"
